#include <zephyr/dt-bindings/pinctrl/nrf-pinctrl.h>

/* Keep the existing UART available for the USB console. */
&uart20 {
    status = "okay";
};

/* Assign separate pins for the external TTL adapter. */
&pinctrl {
    ttl_uart_default: ttl_uart_default {
        group1 {
            psels = <NRF_PSEL(UART_TX, 1, 10)>;
        };

        group2 {
            psels = <NRF_PSEL(UART_RX, 1, 11)>;
            bias-pull-up;
        };
    };

    ttl_uart_sleep: ttl_uart_sleep {
        group1 {
            psels = <NRF_PSEL(UART_TX, 1, 10)>,
                    <NRF_PSEL(UART_RX, 1, 11)>;
            low-power-enable;
        };
    };
};

&uart21 {
    status = "okay";
    current-speed = <115200>;

    pinctrl-0 = <&ttl_uart_default>;
    pinctrl-1 = <&ttl_uart_sleep>;
    pinctrl-names = "default", "sleep";
};
